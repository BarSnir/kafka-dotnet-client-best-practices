{
  "title": "Kafka .NET Client Metrics",
  "uid": "kafka-dotnet-client-metrics",
  "schemaVersion": 39,
  "version": 4,
  "panels": [
    {
      "type": "row",
      "title": "Producer",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Produced messages/s",
      "targets": [
        {
          "expr": "rate(kafka_client_txmsgs_total{role=\"producer\"}[1m])",
          "refId": "A",
          "legendFormat": "{{client_id}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Produced payload bytes/s",
      "targets": [
        {
          "expr": "rate(kafka_client_txmsg_bytes_total{role=\"producer\"}[1m])",
          "refId": "A",
          "legendFormat": "{{client_id}}"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Messages in producer queue",
      "targets": [
        {
          "expr": "kafka_client_msg_cnt{role=\"producer\"}",
          "refId": "A",
          "legendFormat": "{{client_id}}"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Broker request retries/s",
      "targets": [
        {
          "expr": "rate(kafka_client_broker_txretries_total{role=\"producer\"}[1m])",
          "refId": "A",
          "legendFormat": "{{client_id}} / {{broker}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Broker request RTT p95 (ms)",
      "targets": [
        {
          "expr": "kafka_client_broker_rtt_p95_ms{role=\"producer\"}",
          "refId": "A",
          "legendFormat": "{{client_id}} / {{broker}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "Consumer",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Consumed messages/s",
      "targets": [
        {
          "expr": "rate(kafka_client_rxmsgs_total{role=\"consumer\"}[1m])",
          "refId": "A",
          "legendFormat": "{{client_id}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Consumed payload bytes/s",
      "targets": [
        {
          "expr": "rate(kafka_client_rxmsg_bytes_total{role=\"consumer\"}[1m])",
          "refId": "A",
          "legendFormat": "{{client_id}}"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 18,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Committed-offset lag by partition",
      "targets": [
        {
          "expr": "kafka_client_consumer_lag{role=\"consumer\"}",
          "refId": "A",
          "legendFormat": "{{client_id}} / p{{partition}}"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 18,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Rebalances observed per consumer",
      "targets": [
        {
          "expr": "kafka_client_rebalance_cnt_total{role=\"consumer\"}",
          "refId": "A",
          "legendFormat": "{{client_id}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Partitions assigned per consumer",
      "targets": [
        {
          "expr": "kafka_client_assignment_size{role=\"consumer\"}",
          "refId": "A",
          "legendFormat": "{{client_id}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Producer recent broker throttle (ms)",
      "targets": [
        {
          "expr": "kafka_client_broker_recent_throttle_ms{role=\"producer\"}",
          "refId": "A",
          "legendFormat": "{{client_id}} / {{broker}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "description": "Peak delay in the latest positive librdkafka statistics interval for this broker. Held for 60 seconds after observation."
    },
    {
      "type": "timeseries",
      "title": "Consumer recent broker throttle (ms)",
      "targets": [
        {
          "expr": "kafka_client_broker_recent_throttle_ms{role=\"consumer\"}",
          "refId": "A",
          "legendFormat": "{{client_id}} / {{broker}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "description": "Peak delay in the latest positive librdkafka statistics interval for this broker. Held for 60 seconds after observation."
    },
    {
      "type": "timeseries",
      "title": "Produced MB/s by partition",
      "targets": [
        {
          "expr": "sum by (client_id, partition) (rate(kafka_client_partition_tx_bytes_total[1m])) / 1e6",
          "refId": "A",
          "legendFormat": "{{client_id}} / p{{partition}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Producer network send rate (MB/s)",
      "description": "All Kafka request bytes sent by this client, including headers, protocol overhead and retries.",
      "targets": [
        {
          "expr": "rate(kafka_client_tx_bytes_total{role=\"producer\",client_id!=\"\"}[1m]) / 1e6",
          "refId": "A",
          "legendFormat": "{{client_id}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 24,
        "h": 8
      }
    }
  ]
}
